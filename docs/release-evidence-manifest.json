{
  "schema_version": "mobile-ai-keyboard.release-evidence-manifest.v1",
  "required_commands": [
    {"id": "shared_check", "command": "pnpm check", "purpose": "shared TypeScript build and tests"},
    {"id": "ios_core_tests", "command": "swift test", "purpose": "iOS core tests"},
    {"id": "ios_project_generation", "command": "xcodegen generate --spec project.yml", "purpose": "reproducible iOS project"},
    {"id": "ios_simulator_build", "command": "xcodebuild", "purpose": "iOS host and extension build"},
    {"id": "android_tests_lint_apk", "command": "./gradlew --no-daemon testDebugUnitTest lintDebug assembleDebug", "purpose": "Android unit, lint, and APK"},
    {"id": "dependency_audit", "command": "pnpm audit --prod --audit-level high", "purpose": "production dependency audit"},
    {"id": "deterministic_performance_benchmark", "command": "pnpm benchmark:performance", "purpose": "content-free local threshold regression diagnostic"},
    {"id": "shortcut_vectors_check", "command": "pnpm shortcuts:vectors:check", "purpose": "TypeScript-authoritative shortcut golden vector check"},
    {"id": "shortcut_vectors_native_consumers", "command": "pnpm shortcuts:vectors:native-check", "purpose": "source gate requiring direct Swift and Kotlin golden-vector unit consumers"},
    {"id": "shortcut_vertical_slice_source", "command": "node scripts/check-shortcut-vertical-slice.mjs --strict", "purpose": "Builder/Add/A-Z/native snapshot/closed IME source seams remain wired on both platforms"}
  ],
  "required_artifacts": [
    {"id": "release_readiness_report", "path": "release-readiness.json", "class": "static_ci_report"},
    {"id": "shortcut_native_consumer_report", "path": "shortcut-native-consumption.json", "class": "static_ci_report"},
    {"id": "ios_archive_entitlement_privacy_report", "path": "ios-archive-entitlement-privacy.json", "class": "protected_external", "status": "not_proven"},
    {"id": "real_device_e2e_matrix", "path": "docs/release-e2e-matrix.json", "class": "protected_external", "status": "not_proven"},
    {"id": "performance_evidence", "path": "docs/release-performance-evidence.json", "class": "protected_external", "status": "not_proven"},
    {"id": "performance_benchmark_diagnostic", "path": "performance-benchmark.json", "class": "local_diagnostic", "status": "not_proven"}
  ],
  "qualification_rule": "A release is not qualified by local fixtures, simulator/JVM runs, or self-attested evidence. Missing protected artifacts are not_proven and fail the release gate."
}
