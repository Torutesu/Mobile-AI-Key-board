{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-ai-keyboard.invalid/schemas/real-device-e2e-v1.json",
  "title": "Mobile AI Keyboard real-device E2E evidence",
  "type": "object",
  "required": ["schema_version", "status", "evidence_class", "candidate", "required_scenarios", "targets", "required_field_classes", "required_lifecycle_events"],
  "properties": {
    "schema_version": {"const": "mobile-ai-keyboard.real-device-e2e.v1"},
    "status": {"enum": ["not_proven", "in_progress", "passed", "failed"]},
    "evidence_class": {"const": "protected_external"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "required_scenarios": {"type": "array", "minItems": 13, "items": {"type": "string"}},
    "targets": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/target"}},
    "required_field_classes": {"type": "array", "minItems": 10, "items": {"type": "string"}},
    "required_lifecycle_events": {"type": "array", "minItems": 6, "items": {"type": "string"}}
  },
  "$defs": {
    "candidate": {"type": "object", "required": ["source_commit", "artifact_digest"], "properties": {"source_commit": {"type": ["string", "null"]}, "artifact_digest": {"type": ["string", "null"]}}, "additionalProperties": false},
    "target": {"type": "object", "required": ["platform", "device_class", "os", "devices", "device_classes", "apps", "status", "runs"], "properties": {"platform": {"enum": ["ios", "android"]}, "device_class": {"type": "string"}, "os": {"type": "string"}, "devices": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "device_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "apps": {"type": "array", "minItems": 7, "items": {"type": "string"}}, "status": {"enum": ["not_proven", "in_progress", "passed", "failed"]}, "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}}}, "additionalProperties": false},
    "result": {"type": "object", "required": ["status", "run_id", "evidence_ref", "evidence_digest"], "properties": {"status": {"const": "passed"}, "run_id": {"type": "string", "minLength": 1}, "evidence_ref": {"type": "string", "minLength": 1}, "evidence_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}, "additionalProperties": false},
    "scenario_result": {"type": "object", "required": ["scenario_id", "status", "run_id", "evidence_ref", "evidence_digest"], "properties": {"scenario_id": {"type": "string"}, "status": {"const": "passed"}, "run_id": {"type": "string", "minLength": 1}, "evidence_ref": {"type": "string", "minLength": 1}, "evidence_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}, "additionalProperties": false},
    "field_result": {"type": "object", "required": ["field_class", "status", "run_id", "evidence_ref", "evidence_digest"], "properties": {"field_class": {"type": "string"}, "status": {"const": "passed"}, "run_id": {"type": "string", "minLength": 1}, "evidence_ref": {"type": "string", "minLength": 1}, "evidence_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}, "additionalProperties": false},
    "lifecycle_result": {"type": "object", "required": ["lifecycle_event", "status", "run_id", "evidence_ref", "evidence_digest"], "properties": {"lifecycle_event": {"type": "string"}, "status": {"const": "passed"}, "run_id": {"type": "string", "minLength": 1}, "evidence_ref": {"type": "string", "minLength": 1}, "evidence_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}, "additionalProperties": false},
    "app_evidence": {"type": "object", "required": ["app_id", "app_identifier", "run_id", "evidence_ref", "evidence_digest"], "properties": {"app_id": {"type": "string"}, "app_identifier": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "evidence_ref": {"type": "string", "minLength": 1}, "evidence_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}, "additionalProperties": false},
    "attestation": {"type": "object", "required": ["status", "verifier_kind", "verifier_id", "verification_id", "signature", "issued_at", "expires_at", "nonce", "run_id", "device_id", "source_commit", "artifact_digest"], "properties": {"status": {"const": "verified"}, "verifier_kind": {"const": "protected_runner"}, "verifier_id": {"type": "string", "minLength": 1}, "verification_id": {"type": "string", "minLength": 1}, "signature": {"type": "string", "minLength": 1}, "issued_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"}, "run_id": {"type": "string", "minLength": 1}, "device_id": {"type": "string", "minLength": 1}, "source_commit": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"}, "artifact_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}, "additionalProperties": false},
    "run": {"type": "object", "required": ["status", "run_id", "runner_id", "evidence_class", "environment", "device_id", "device_class", "device_model", "os_version", "source_commit", "artifact_digest", "attestation", "scenario_results", "field_class_results", "lifecycle_results", "accessibility_tools", "app_evidence"], "properties": {"status": {"const": "passed"}, "run_id": {"type": "string", "minLength": 1}, "runner_id": {"type": "string", "minLength": 1}, "evidence_class": {"const": "protected_external"}, "environment": {"const": "protected_device"}, "device_id": {"type": "string", "minLength": 1}, "device_class": {"type": "string", "minLength": 1}, "device_model": {"type": "string", "minLength": 1}, "os_version": {"type": "string", "minLength": 1}, "source_commit": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"}, "artifact_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "attestation": {"$ref": "#/$defs/attestation"}, "scenario_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario_result"}}, "field_class_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field_result"}}, "lifecycle_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lifecycle_result"}}, "accessibility_tools": {"type": "array", "minItems": 1, "items": {"enum": ["voiceover", "talkback"]}}, "app_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/app_evidence"}}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
